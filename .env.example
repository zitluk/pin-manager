PIHOLE_URL=http://192.168.1.10
PIHOLE_PASSWORD=your-pihole-web-password
# --- Režim nasazení (viz scripts/configure.py) ---
# DEPLOY_MODE=vlan | bridge
# PORTAINER_COMPOSE_PATH=portainer-stack.vlan.yml

# VLAN (macvlan) – bez portů
# VLAN_NETWORK_NAME=docker_vlan
# VLAN_IP=192.168.39.207
PORTAL_IP=192.168.39.207

# Bridge – mapování portu
# HOST_PORT=80
PIN=1234
# Nebo: PIN_HASH=$2b$12$...
DURATION_OPTIONS=15,30,60,120
PIHOLE_RESTART_DNS=true
ADMIN_TOKEN=change-me-long-random
SESSION_SECRET=change-me-session-signing-secret
# Cesta na hostu sdílená s Pi-hole (dnsmasq.d)
DNSMASQ_SYNC_HOST_PATH=./dnsmasq-sync
