# Zkopírujte do .env (docker compose) nebo do proměnných stacku v Portaineru.

PIHOLE_URL=http://192.168.39.5
PIHOLE_PASSWORD=
# PIN pro dočasné povolení stránky i přihlášení do správy
PIN=
DURATION_OPTIONS=15,30,60,120

# Jen docker-compose.yml: port na hostiteli
HOST_PORT=8080

# Jen portainer-stack.yml: IP kontejneru v existující macvlan síti
VLAN_IP=192.168.39.207
MACVLAN_NETWORK_NAME=docker_vlan

# Volitelné (výchozí hodnoty)
# PIHOLE_RESYNC_SECONDS=300
# PIHOLE_RESTART_DNS=true
# BLOCK_DNS_BYPASS=true
# MAX_PIN_ATTEMPTS=5
# LOCKOUT_SECONDS=300
