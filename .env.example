# Portainer stack env – VLAN Lukas (výchozí IP 192.168.39.207)

DEPLOY_MODE=vlan
PORTAINER_COMPOSE_PATH=portainer-stack.yml

PORTAL_IP=192.168.39.207
VLAN_IP=192.168.39.207
VLAN_NETWORK_NAME=docker_vlan

PIHOLE_URL=http://192.168.39.1
PIHOLE_PASSWORD=

PIN=
PIN_HASH=

# Po registraci administrátora se API token uloží do /data/admin.json
# ADMIN_TOKEN volitelné (legacy Bearer)
SESSION_SECRET=

DNSMASQ_SYNC_HOST_PATH=/opt/pin-manager/dnsmasq-sync
DURATION_OPTIONS=15,30,60,120
PIHOLE_RESTART_DNS=true
